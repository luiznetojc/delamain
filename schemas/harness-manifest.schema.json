{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delamain.dev/schemas/harness-manifest.schema.json",
  "title": "Delamain Harness Manifest",
  "type": "object",
  "required": ["schemaVersion", "project", "profile", "runtimes", "skills", "workflows", "policies"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]{1,62}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "primaryLanguage": { "type": "string", "enum": ["typescript", "javascript", "csharp", "polyglot"] }
      }
    },
    "profile": {
      "type": "string",
      "enum": ["dotnet", "node", "typescript", "minimal"]
    },
    "harnessSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["claude-code", "codex", "agy"]
      }
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredRuntime": { "type": "string", "enum": ["claude-code", "codex", "agy"] },
        "useOrcaWhenAvailable": { "type": "boolean" },
        "maxParallelAgents": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "workflows": {
      "type": "object",
      "required": ["default", "enabled"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "enabled": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "telemetry": { "type": "boolean" },
        "safetyGuards": { "type": "boolean" }
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["build", "unit-test", "integration-test", "lint", "typecheck", "coverage", "mutation", "sonarqube", "custom"] },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
          "required": { "type": "boolean" },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": ["allowDestructiveCommands", "allowBypassPermissions", "redactSecretsInLogs"],
      "additionalProperties": false,
      "properties": {
        "allowDestructiveCommands": { "type": "boolean" },
        "allowBypassPermissions": { "type": "boolean", "const": false },
        "redactSecretsInLogs": { "type": "boolean", "const": true },
        "protectedBranches": { "type": "array", "items": { "type": "string" } },
        "forbiddenPaths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
