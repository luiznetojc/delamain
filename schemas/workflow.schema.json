{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delamain.dev/schemas/workflow.schema.json",
  "title": "Delamain Declarative Workflow",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "stages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "lifecycleHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onWorkflowStart": { "type": "array", "items": { "type": "string" } },
        "onWorkflowComplete": { "type": "array", "items": { "type": "string" } },
        "onWorkflowFail": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "enabled", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "role": { "type": "string", "enum": ["coordinator", "planner", "architect", "implementer", "tester", "reviewer", "security-auditor", " documenter"] },
          "enabled": { "type": "boolean" },
          "mandatoryGate": { "type": "boolean" },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" }
          },
          "preferredRuntime": { "type": "string", "enum": ["claude-code", "codex", "agy", "any"] },
          "preferredModel": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "validators": { "type": "array", "items": { "type": "string" } },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "retryPolicy": {
            "type": "object",
            "required": ["maxRetries"],
            "additionalProperties": false,
            "properties": {
              "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
              "backoffMs": { "type": "integer", "minimum": 0, "maximum": 300000 }
            }
          },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 7200000 },
          "approvalGate": {
            "type": "object",
            "required": ["required"],
            "additionalProperties": false,
            "properties": {
              "required": { "type": "boolean" },
              "approver": { "type": "string", "enum": ["human", "coordinator", "automated-validators"] },
              "reason": { "type": "string" }
            }
          },
          "hooks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "beforeStage": { "type": "array", "items": { "type": "string" } },
              "afterStage": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
